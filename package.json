{
  "name": "pokrr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "knip": "knip",
    "knip:production": "knip --production",
    "dev": "concurrently -n next,party -c cyan,magenta \"npm:dev:next\" \"npm:dev:party\"",
    "dev:next": "next dev --webpack",
    "dev:party": "partykit dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "party:deploy": "partykit deploy",
    "smoke": "node scripts/smoke-room.mjs",
    "smoke:election": "POKRR_ADMIN_GRACE_MS=2000 node scripts/smoke-admin-election.mjs",
    "smoke:security": "node scripts/smoke-security.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.59.0",
    "nanoid": "6.0.2",
    "next": "16.4.2",
    "partysocket": "^1.3.0",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "partykit": "^0.0.115",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.6"
    }
  }
}
