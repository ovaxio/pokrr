# --- Next.js front ---

# Hostname du Worker PartyServer (sans protocole).
# Local : localhost:1999. Prod : pokrr.<sous-domaine>.workers.dev.
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999

# URL canonique du site (optionnel, sinon Vercel utilise VERCEL_URL).
# Sert au metadataBase pour les balises Open Graph / Twitter.
# NEXT_PUBLIC_SITE_URL=https://pokrr.app

# --- Worker (chargé via .env au démarrage de `wrangler dev`, exposé via this.env et process.env).
# Ne pas créer de .dev.vars : wrangler ignorerait alors .env. ---

# Fenêtre de grâce avant élection auto d'un nouvel admin si l'admin se déconnecte.
# Défaut prod : 60000 ms (1 min). Mettre 2000 en dev pour tester rapidement.
POKRR_ADMIN_GRACE_MS=60000

# Fermeture d'une salle sans aucune action acceptée d'un joueur joint pendant cette durée.
# Défaut prod : 7200000 ms (2 h). Mettre 8000 pour lancer `npm run smoke:idle`.
POKRR_IDLE_TIMEOUT_MS=7200000

# Fermeture (code 4002) d'une connexion restée sans `join` pendant cette durée.
# Défaut prod : 300000 ms (5 min). Mettre 5000 pour lancer `npm run smoke:idle`.
POKRR_JOIN_TIMEOUT_MS=300000
